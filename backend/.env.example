# Copy to .env and adjust. Never commit .env.

# --- Network ---
# Local only by default: the desk answers to this machine and nothing else.
# Driver Social Security numbers are in these files.
HOST=127.0.0.1
PORT=8000

# Origins allowed to call the API. The Next.js dev server only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set HOST to 0.0.0.0 to let other devices reach the desk. That requires an
# account to exist — the app refuses to start otherwise, because these files
# hold driver Social Security numbers. See ACCESS.md.
#   python -m app.cli create-user
#
# Only turn this on behind HTTPS. On a private network the desk is served
# over plain HTTP and a secure-only cookie would never be sent.
SESSION_COOKIE_SECURE=false

# --- Storage ---
# Absolute or relative to the backend/ directory. Keep outside the repo in
# production; the default is gitignored.
STORAGE_ROOT=storage

# --- Database ---
# Swap for a Postgres URL to move off SQLite; nothing else changes.
DATABASE_URL=sqlite:///./contract_desk.db

# --- Secrets ---
# Salt for hashing Social Security numbers. Generate one and keep it stable:
# a changed salt orphans every existing hash.
#   python -c "import secrets; print(secrets.token_hex(32))"
SSN_SALT=change-me-before-first-real-contract

# --- Limits ---
MAX_UPLOAD_MB=50
