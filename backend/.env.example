# Copy to .env and adjust. Never commit .env.

# --- Network ---
# Local only. Driver Social Security numbers are in these files and must not
# cross a network. Do not change this to 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# Origins allowed to call the API. The Next.js dev server only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Storage ---
# Absolute or relative to the backend/ directory. Keep outside the repo in
# production; the default is gitignored.
STORAGE_ROOT=storage

# --- Database ---
# Swap for a Postgres URL to move off SQLite; nothing else changes.
DATABASE_URL=sqlite:///./contract_desk.db

# --- Secrets ---
# Salt for hashing Social Security numbers. Generate one and keep it stable:
# a changed salt orphans every existing hash.
#   python -c "import secrets; print(secrets.token_hex(32))"
SSN_SALT=change-me-before-first-real-contract

# --- Limits ---
MAX_UPLOAD_MB=50
